#!/usr/bin/env python3
"""
ax — AX-GRAPH CLI wrapper

Resolves the plugin root at runtime (whether installed via Claude Code marketplace,
Kimi Code /plugins install, or invoked directly), then forwards subcommands to
lib/graph_query.py (and friends) without forcing callers to know the install path.

Subcommands:
    ax init     Initialize .axgraph/ in the current project root
    ax query    Query a node or list bases (forwards to graph_query.py)
    ax purity   Function purity analysis (forwards to purity.py)
    ax diagnose Feature-chain diagnosis (forwards to diagnose.py)
    ax update   Update a node (forwards to graph_query.py --update)
    ax extract  Extract CALLS candidates from a Python file (call_candidates.py)
    ax --help   Show this help

The wrapper intentionally does NOT shell out to a subprocess when avoidable —
direct imports are 5x faster and avoid the "script not found after install" class
of bugs. We still respect $AX_GRAPH_PYTHON (defaults to /usr/bin/env python3) so
users with venv quirks can override.

Resolution order for plugin root:
    1. $AX_GRAPH_ROOT (explicit override)
    2. Walk up from this file: .../axgraph/bin/ax  →  ../  is the plugin root
    3. Hard fail with a clear message
"""

from __future__ import annotations

import argparse
import importlib.util
import os
import sys
from pathlib import Path


def _resolve_plugin_root() -> Path:
    """Find the axgraph plugin root regardless of how `ax` was invoked."""
    override = os.environ.get("AX_GRAPH_ROOT")
    if override:
        root = Path(override).expanduser().resolve()
        if not (root / "lib" / "graph_query.py").exists():
            sys.exit(
                f"ax: AX_GRAPH_ROOT={root} does not look like an axgraph plugin "
                f"(missing lib/graph_query.py)."
            )
        return root

    here = Path(__file__).resolve().parent
    # Walk up at most 3 levels to handle symlinked PATH installs (common on macOS/Linux)
    for candidate in (here, here.parent, here.parent.parent):
        if (candidate / "lib" / "graph_query.py").exists():
            return candidate

    sys.exit(
        f"ax: cannot locate axgraph plugin root from {here}. "
        f"Set $AX_GRAPH_ROOT to the plugin install directory."
    )


def _load_module(root: Path, module_file: str, module_name: str):
    """Import a lib/*.py file as a real Python module so we can call main() directly."""
    path = root / "lib" / module_file
    if not path.exists():
        sys.exit(f"ax: missing {path} (plugin install is broken?)")
    spec = importlib.util.spec_from_file_location(module_name, path)
    if spec is None or spec.loader is None:
        sys.exit(f"ax: cannot import {path}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = mod
    spec.loader.exec_module(mod)
    return mod


def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="ax",
        description="AX-GRAPH — layered source-code graph for any project (Claude Code / Kimi Code plugin).",
    )
    p.add_argument("--root", help="Override plugin root (default: auto-detect from this script's location).")
    p.add_argument("--version", action="store_true", help="Show plugin version and exit.")
    sub = p.add_subparsers(dest="cmd", metavar="<subcommand>")

    # init — special: does NOT need an existing .axgraph/, creates one
    init_p = sub.add_parser("init", help="Initialize .axgraph/ in the current project (interactive).")
    init_p.add_argument("--project-root", default=".", help="Project root (default: cwd).")
    init_p.add_argument("--type", choices=["dir", "file"], default="dir",
                        help="Graph type — 'dir' for whole-project graph, 'file' for single-file AST graph.")
    init_p.add_argument("--source", help="Source path for --type=file (relative to project root).")

    # query — passthrough to graph_query.py
    sub.add_parser("query", help="Query a node or list bases (forwards to graph_query.py).")
    sub.add_parser("purity", help="Function purity analysis (forwards to purity.py).")
    sub.add_parser("diagnose", help="Feature-chain diagnosis (forwards to diagnose.py).")
    sub.add_parser("update", help="Update a node (forwards to graph_query.py --update).")
    sub.add_parser("extract", help="Extract CALLS candidates from a Python file (call_candidates.py).")

    return p


_KNOWN_CMDS = {"init", "query", "purity", "diagnose", "update", "extract"}
_WRAPPER_FLAGS_WITH_VALUE = {"--root"}


def _split_unknown_subcommand(raw):
    """把 ax 后的 argv 切成 (pre, query_default, rest)。

    pre           : wrapper 自己的 flag + value（保留给 argparse 处理）
    query_default : 如果第一个非 wrapper 位置参数不是已知子命令，这里返回它；
                    否则 None（让 argparse 正常选子命令）
    rest          : 第一个非 wrapper 位置参数之后的所有东西

    例：
        ['mod.agent', '-c', '-r']              → ([], 'mod.agent', ['-c','-r'])
        ['--root', '/p', 'mod.agent']          → (['--root','/p'], 'mod.agent', [])
        ['query', 'mod.agent']                 → ([], None, [])    # 让 argparse 走 query
        ['--root', '/p', 'init']               → (['--root','/p'], None, [])
        ['init', '--project-root', '/p']       → ([], None, [])    # 让 argparse 走 init
    """
    i = 0
    while i < len(raw):
        a = raw[i]
        if a in _WRAPPER_FLAGS_WITH_VALUE and i + 1 < len(raw):
            i += 2
            continue
        if a.startswith("--") and "=" not in a:
            # 未知 wrapper flag：当作不需要 value，跳过（保守处理）
            i += 1
            continue
        break
    pre = raw[:i]
    rest = raw[i:]
    if not rest:
        return pre, None, []
    first = rest[0]
    if first in _KNOWN_CMDS:
        return pre, None, []
    return pre, first, rest[1:]


def main() -> int:
    # ax wrapper 自己的参数（先于子命令解析）
    WRAPPER_FLAGS = {"--root", "--version", "-h", "--help"}

    # 如果用户在 ax 后面直接跟非子命令的位置参数（如 ax mod.agent），
    # 把第一个未知位置参数当作 query 的目标，剩下的作 forwarded。
    # 这样 'ax mod.agent -c -r' 等价于 'ax query mod.agent -c -r'。
    # 跳过 wrapper 自己的 flag 和它们的 value。
    raw = sys.argv[1:]
    pre, query_default, rest = _split_unknown_subcommand(raw)

    if query_default is not None:
        # 把 [pre..., "query", query_default, rest...] 交给 argparse
        sys.argv = [sys.argv[0]] + pre + ["query", query_default] + rest
    else:
        sys.argv = sys.argv[:1] + raw

    args, forwarded = _build_parser().parse_known_args()

    # 处理 query_default 已被 'query' 子命令吃进去的情况：
    # 如果 cmd == "query" 且 forwarded 里没有查询关键词，把 query_default 加回去
    if query_default is not None and not forwarded:
        forwarded = [query_default] + rest

    # 处理 '--' 透传边界：argparse.REMAINDER 不够用，手动恢复 forwarded
    # argparse parse_known_args 已经把未知 flag 留到 forwarded，正常。

    root = Path(args.root).expanduser().resolve() if args.root else _resolve_plugin_root()
    if args.version:
        version_file = root / "VERSION"
        if version_file.exists():
            print(version_file.read_text().strip())
        else:
            print("ax: version file not present (dev install?)")
        return 0

    if not args.cmd:
        # 无子命令 = 直接转发到 graph_query.py（最 unix 的行为：ax 是 wrapper，
        # 无参数时与底层工具完全等价；graph_query.py 自己处理无参 → 列出可查节点）
        args.cmd = "query"
        forwarded = []

    if args.cmd == "init":
        return _cmd_init(root, args)

    # 其他子命令：cd 进数据目录（被分析项目的 .axgraph/），让老 lib 工具
    # （graph_query / diagnose / purity）的 BASE 解析能找到 base-* 目录。
    # 优先级：
    #   1. cwd 已经在 .axgraph/ 内（用户手动 cd 进去）→ 保持 cwd
    #   2. cwd 的 .axgraph/ 存在 → cd 进去
    #   3. env AX_GRAPH_DATA_DIR → cd 进去
    #   4. 都没有 → 保持 cwd（让 lib 工具自己报"找不到 base"）
    cwd = Path.cwd()
    data_dir = None
    if cwd.name == ".axgraph":
        data_dir = cwd
    elif (cwd / ".axgraph").is_dir():
        data_dir = cwd / ".axgraph"
    elif os.environ.get("AX_GRAPH_DATA_DIR"):
        data_dir = Path(os.environ["AX_GRAPH_DATA_DIR"])

    original_cwd = None
    if data_dir is not None and data_dir.resolve() != cwd.resolve():
        original_cwd = cwd
        os.chdir(data_dir)

    try:
        return _forward_to_lib(root, args.cmd, forwarded)
    finally:
        if original_cwd is not None:
            os.chdir(original_cwd)


def _forward_to_lib(root: Path, cmd: str, forwarded: list) -> int:
    """Hand off to the corresponding lib/*.py with forwarded args."""
    target = {
        "query":   ("graph_query.py",   "ax_graph_query"),
        "update":  ("graph_query.py",   "ax_graph_query"),
        "purity":  ("purity.py",        "ax_purity"),
        "diagnose":("diagnose.py",      "ax_diagnose"),
        "extract": ("call_candidates.py","ax_call_candidates"),
    }[cmd]
    mod = _load_module(root, target[0], target[1])

    # The lib/*.py scripts do not accept --project-root; they derive .axgraph/
    # from the cwd or --base flag. We don't inject anything — the caller is
    # responsible for cwd or for passing --base explicitly.
    sys.argv = [f"ax {cmd}"] + forwarded
    if hasattr(mod, "main"):
        return mod.main()
    if hasattr(mod, "cli"):
        return mod.cli()
    # Fallback: execute as script (re-run with argv)
    sys.exit(mod.__name__)


def _cmd_init(root: Path, args: argparse.Namespace) -> int:
    """Scaffold .axgraph/ inside a target project. This is the one subcommand we
    implement here (rather than forwarding) because it's the onboarding entrypoint
    and needs to know about the plugin's own copy of SCHEMA.md / AGENTS.md."""
    import shutil

    project_root = Path(args.project_root).expanduser().resolve()
    if not project_root.is_dir():
        sys.exit(f"ax init: project root {project_root} is not a directory.")
    axgraph_dir = project_root / ".axgraph"
    if axgraph_dir.exists():
        print(f"ax init: {axgraph_dir} already exists — nothing to do.")
        print(f"       run `ax query --bases` inside the project to inspect.")
        return 0

    # Scaffold: copy docs/SCHEMA.md into .axgraph/ so the user has the editing
    # manual right next to their graph. We deliberately do NOT copy README.md
    # (it's the axgraph-plugin self-description, irrelevant once the user has
    # decided to install), AGENTS.md (project-internal collaboration rules,
    # already covered by the injected SKILL.md), or How-to-update-graph.md
    # (advanced maintenance doc, the user can `cat` from the axgraph install
    # dir when needed). Keep .axgraph/ minimal — the graph itself is the
    # artifact; reference docs stay in the plugin's docs/.
    axgraph_dir.mkdir()
    for doc in ("SCHEMA.md",):
        src = root / "docs" / doc
        if src.exists():
            shutil.copy2(src, axgraph_dir / doc)

    # Initialize either a dir-graph or a file-graph base
    if args.type == "dir":
        base_name = project_root.name
        base_dir = axgraph_dir / f"base-dir-{base_name}"
        base_dir.mkdir()
        # Create empty Layer-1/2 TOMLs and a base.toml manifest
        (base_dir / "base.toml").write_text(
            f'[graph]\nname = "{base_name}"\nlayer = "1"\ngranularity = "module+file"\n'
            f'created = "{_today_iso()}"\nschema = "axgraph-1.0"\nnote = "auto-init via ax init"\n\n'
            f'[source]\npath = "."\nrepo = "{project_root}"\ntype = "dir"\n'
        )
        (base_dir / "Layer-1-Graph.toml").write_text(
            "# Layer 1: module/file distribution. See SCHEMA.md for node/edge format.\n"
            "# Add nodes like:\n#   [[nodes]]\n#   id = \"mod.<name>\"\n#   kind = \"module\"\n#   path = \"<path>\"\n#   layer = \"core\"\n#   desc = \"...\"\n"
        )
        (base_dir / "Layer-2-Graph.toml").write_text(
            "# Layer 2: implicit clusters (named pattern + dependency cohesion).\n"
            "# See SCHEMA.md for cluster vs subpackage semantics.\n"
        )
        print(f"ax init: created dir-graph base → {base_dir}")
    else:
        # File-graph: needs --source
        if not args.source:
            sys.exit("ax init: --source <file> is required when --type=file.")
        source = (project_root / args.source).resolve()
        if not source.is_file():
            sys.exit(f"ax init: source file {source} does not exist.")
        base_name = source.stem
        base_dir = axgraph_dir / f"base-file-{base_name}"
        base_dir.mkdir()
        (base_dir / "base.toml").write_text(
            f'[graph]\nname = "{base_name}"\nlayer = "1"\ngranularity = "function"\n'
            f'created = "{_today_iso()}"\nschema = "axgraph-1.0"\nnote = "auto-init via ax init (file mode)"\n\n'
            f'[source]\npath = "{args.source}"\nrepo = "{project_root}"\ntype = "file"\n'
        )
        print(f"ax init: created file-graph base → {base_dir}")
        print(f"         next: ax graph_query.py (AST seed) — see docs/How-to-update-graph.md")

    print()
    print("Next steps:")
    print(f"  cd {project_root}")
    print("  ax query --bases              # verify base is registered")
    print(f"  cat .axgraph/SCHEMA.md        # editing manual for [[nodes]] / [[edges]]")
    print(f"  # Other references stay in the axgraph plugin:")
    print(f"  #   docs/AGENTS.md           (collaboration rules — also in injected SKILL.md)")
    print(f"  #   docs/How-to-update-graph.md (line-number drift handling)")
    return 0


def _today_iso() -> str:
    from datetime import date
    return date.today().isoformat()


if __name__ == "__main__":
    sys.exit(main() or 0)
